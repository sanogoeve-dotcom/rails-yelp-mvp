<div class="container mt-5">
  <h1>Ajouter un avis pour <%= @restaurant.name %></h1>

  <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :rating, collection: 0..5, label: "Note (entre 0 et 5)" %>
    <%= f.input :content, label: "Commentaire" %>
    <%= f.button :submit, "Soumettre l'avis", class: "btn btn-primary" %>
  <% end %>

  <br>
  <%= link_to "Retour aux détails", restaurant_path(@restaurant), class: "btn btn-outline-secondary mt-3" %>
</div>