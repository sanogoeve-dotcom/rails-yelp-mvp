<div class="container mt-5">
  <h1>Nos Restaurants</h1>
  
  <ul class="list-group mt-3">
    <% @restaurants.each do |restaurant| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <strong><%= restaurant.name %></strong> - <span class="text-muted"><%= restaurant.category %></span>
          <br><small><%= restaurant.address %></small>
        </div>
        <%= link_to "Voir les détails", restaurant_path(restaurant), class: "btn btn-primary btn-sm" %>
      </li>
    <% end %>
  </ul>
</div>