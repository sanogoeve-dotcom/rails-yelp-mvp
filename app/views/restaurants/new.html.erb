<div class="container mt-5">
  <h1>Ajouter un nouveau restaurant</h1>

  <%= simple_form_for(@restaurant) do |f| %>
    <%= f.input :name, label: "Nom" %>
    <%= f.input :address, label: "Adresse" %>
    <%= f.input :phone_number, label: "Téléphone" %>
    <%= f.input :category, collection: Restaurant::CATEGORIES, label: "Catégorie" %>
    <%= f.button :submit, "Créer le restaurant", class: "btn btn-primary" %>
  <% end %>

  <br>
  <%= link_to "Retour à la liste", restaurants_path, class: "btn btn-outline-secondary mt-3" %>
</div>